# Optional. The app runs the offline planner when neither of these is set.
# On Vercel, an OIDC token is provided for deployments and is used automatically.
AI_GATEWAY_API_KEY=

# Optional provider/model id from https://ai-gateway.vercel.sh/v1/models
# The default is set in lib/gateway.ts and was chosen because it supports structured output.
AI_GATEWAY_MODEL=
